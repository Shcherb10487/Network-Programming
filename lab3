
#include <iostream>
#include <string>
#include <WinSock2.h>
#include <WS2tcpip.h>

#pragma comment(lib, "WS2_32.Lib")

int server() {
	system("chcp 1251");
	WSADATA ws_data;    // Структура, содержит сведения о реализации сокетов Windows.
	std::cout << "инициализация сокетов...\t\t";
	if (!WSAStartup(MAKEWORD(2, 2), &ws_data)) std::cout << "!Готово\n";
	else {
		std::cout << "ОШИБКА\t" << WSAGetLastError() << std::endl;
		system("pause");
		return 1;
	}
	SOCKET server_socket = socket(AF_INET, SOCK_STREAM, 0);
	if (server_socket == INVALID_SOCKET) {
		std::cout << "Ошибка\t" << WSAGetLastError() << std::endl;
		closesocket(server_socket);
		WSACleanup();
		system("pause");
		return 1;
	}
	else std::cout << "ГОТОВО\n";

	sockaddr_in server_socket_info;
	SecureZeroMemory(&server_socket_info, sizeof(server_socket_info));
	server_socket_info.sin_family = AF_INET;
	server_socket_info.sin_port = htons(47);
	if (inet_pton(AF_INET, "127.0.1.1", &server_socket_info.sin_addr) <= 0) {
		std::cout << "Ошибка преобразования адреса через inet_pton()\n";
		system("pause");
		return 1;
	}

	std::cout << "Привязка сокета по информации сервера...\t\t";
	if (bind(server_socket, (sockaddr*)&server_socket_info, sizeof(server_socket_info)) != 0) {
		std::cout << "ОШИБКА\t" << WSAGetLastError() << std::endl;
		closesocket(server_socket);
		WSACleanup();
		system("pause");
		return 1;
	}
	else std::cout << "ГОТОВО\n";

	std::cout << "Ожидание подключения клиента...\t\t";
	if (listen(server_socket, SOMAXCONN) != 0) {
		std::cout << "Ошибка\t" << WSAGetLastError() << std::endl;
		closesocket(server_socket);
		WSACleanup();
		system("pause");
		return 1;
	}
	else {
		system("pause");
	}

	sockaddr_in client_socket_info;
	ZeroMemory(&client_socket_info, sizeof(client_socket_info));
	int size_of_client_socket_info = sizeof(client_socket_info);
	SOCKET connected_client_socket = accept(server_socket, (sockaddr*)&client_socket_info, &size_of_client_socket_info);
	if (connected_client_socket == INVALID_SOCKET) {
		std::cout << "ОШИБКА соединения с клиентом\t" << WSAGetLastError() << std::endl;
		closesocket(connected_client_socket);
		closesocket(server_socket);
		WSACleanup();
		return 1;
	}
	else std::cout << "ГОТОВО\n";
	system("pause");

	std::cout << "Ожидание сообщения от клиента..\t\t";
	std::string message;
	const int buffer_size = 1024;
	message.resize(buffer_size);
	if (recv(connected_client_socket, message.data(), message.size(), 0) == SOCKET_ERROR) {
		std::cout << "ОШИБКА\t" << WSAGetLastError() << std::endl;
		closesocket(server_socket);
		closesocket(connected_client_socket);
		WSACleanup();
		system("pause");
		return 1;
	}
	else {
		std::cout << "Получено сообщение: " << message << std::endl;
		system("pause");
	}
	closesocket(connected_client_socket);
	closesocket(server_socket);
	WSACleanup();
	return 0;
}

int client() {
	SOCKET client_socket = socket(AF_INET, SOCK_STREAM, 0);
	if (client_socket == INVALID_SOCKET) {
		std::cout << "Ошибка\t" << WSAGetLastError() << std::endl;
		closesocket(client_socket);
		WSACleanup();
		system("pause");
		return 1;
	}
	else std::cout << "ГОТОВО\n";


	sockaddr_in server_info;
	SecureZeroMemory(&server_info, sizeof(server_info));
	server_info.sin_family = AF_INET;
	inet_pton(AF_INET, "127.0.1.1", &server_info.sin_addr); // преобразует в двоичную форму
	server_info.sin_port = htons(47);

	std::cout << "подключение к серверу...\t\t";

	if (!connect(client_socket, (sockaddr*)&server_info, sizeof(server_info))) std::cout << "ГОТОВО\n";
	else {
		std::cout << "ОШИБКА\t" << WSAGetLastError() << std::endl;
		closesocket(client_socket);
		WSACleanup();
		system("pause");
		return 1;
	}
	system("pause");


	const int buffer_size = 1024;
	std::string message;
	std::cout << "Введите сообщение: ";
	std::getline(std::cin, message);
	message.resize(buffer_size);
	std::cout << "отправка сообшения...\t\t";
	if (send(client_socket, message.c_str(), message.size(), 0) == SOCKET_ERROR) {
		std::cout << "OшибKA\t" << WSAGetLastError() << std::endl;
		closesocket(client_socket);
		WSACleanup();
		system("pause");
		return 1;
	}
	else std::cout << "гOTOBO\n";

	closesocket(client_socket);
	WSACleanup();
	system("pause");
	return 0;
}

int main() {
	system("chcp 1251");
	WSADATA ws_data;    // Структура, содержит сведения о реализации сокетов Windows.

	std::cout << "инициализация сокетов...\t\t";
	if (!WSAStartup(MAKEWORD(2, 2), &ws_data)) std::cout << "!Готово\n";
	else {
		std::cout << "ОШИБКА\t" << WSAGetLastError() << std::endl;
		system("pause");
		return 1;
	}
	int menu = 0;
	while (menu != 3) {
		system("cls");
		std::cout << "МЕНУ:\n1.Режим КЛИЕНТА \n2.Режим СЕРВЕРА\n3.выход\n";
		std::cin >> menu;
		switch (menu) {
			case 1: {
				if (client()) std::cout << "\n\nОшибка Клиента";
				break;
			}
			case 2: {
				if (server()) std::cout << "\n\nОшибка Сервера";
				break;
			}
			default: return 0;
		}



	}

}
